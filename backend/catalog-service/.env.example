DATABASE_URL="postgresql://USERNAME:PASSWORD@DB_HOST:5432/DB_NAME"
MIGRATION_DATABASE_URL="postgresql://USERNAME:PASSWORD@MIGRATION_DB_HOST:5432/DB_NAME"

AWS_REGION="REPLACE_WITH_AWS_REGION"
S3_BUCKET="REPLACE_WITH_S3_BUCKET_NAME"

# Set the port for this service, or leave it blank to use the default.
PORT=

REDIS_URL="redis://REDIS_HOST:6379"

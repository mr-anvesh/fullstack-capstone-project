// use prisma-8

model Properties {
  id            String            @id @onCreate(uuid())
  hostId        UuidString
  name          String
  location      String
  pricePerDay   Decimal
  maxGuests     Int
  imageUrls     PropertyImageUrl[]

  @@index([location])
  @@index([hostId])
}

model PropertyImageUrl {
  id           String     @id @onCreate(uuid())
  propertyId   String
  url          String
  displayOrder Int
  property     Properties @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}
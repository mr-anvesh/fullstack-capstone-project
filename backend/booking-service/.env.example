DATABASE_URL="postgresql://USERNAME:PASSWORD@DB_HOST:5432/DB_NAME"
MIGRATION_DATABASE_URL="postgresql://USERNAME:PASSWORD@MIGRATION_DB_HOST:5432/DB_NAME"


RABBITMQ_URL="amqp://USERNAME:PASSWORD@RABBITMQ_HOST:5672"
AUTH_URL="http://AUTH_SERVICE_HOST:AUTH_SERVICE_PORT"

# Use the same token in auth-service and notification-service.
INTERNAL_API_TOKEN="REPLACE_WITH_SHARED_INTERNAL_API_TOKEN"

SMTP_HOST="REPLACE_WITH_SMTP_HOST"
# Set the port required by your SMTP provider.
SMTP_PORT=
SMTP_USER="REPLACE_WITH_SMTP_USERNAME"
SMTP_PASS="REPLACE_WITH_SMTP_PASSWORD"
MAIL_FROM="sender@example.com"

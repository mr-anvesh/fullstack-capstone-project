DATABASE_URL="postgresql://USERNAME:PASSWORD@DB_HOST:5432/DB_NAME"
MIGRATION_DATABASE_URL="postgresql://USERNAME:PASSWORD@MIGRATION_DB_HOST:5432/DB_NAME"

# Set the port for this service, or leave it blank to use the default.
PORT=

# Use the same JWT secret in auth-service and gateway.
JWT_SECRET="REPLACE_WITH_SHARED_JWT_SECRET"
RABBITMQ_URL="amqp://USERNAME:PASSWORD@RABBITMQ_HOST:5672"

# Use the same token in auth-service and notification-service.
INTERNAL_API_TOKEN="REPLACE_WITH_SHARED_INTERNAL_API_TOKEN"
